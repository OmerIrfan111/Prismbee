+/* ============================================================
+   LIQUID GLASS SYSTEM (brand: deep green #064E3B, emerald #10B981)
+   Unlayered on purpose: these utilities must win over Tailwind's
+   layered utilities (e.g. a card's bg-white) where applied.
+   ============================================================ */
+
+/* --- Full frosted glass panel (light surfaces) --- */
+.glass {
+  position: relative;
+  background: linear-gradient(135deg, rgba(255, 255, 255, 0.62) 0%, rgba(240, 253, 244, 0.38) 100%);
+  -webkit-backdrop-filter: blur(18px) saturate(1.5);
+  backdrop-filter: blur(18px) saturate(1.5);
+  border: 1px solid rgba(255, 255, 255, 0.65);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.8),
+    inset 0 -1px 0 rgba(255, 255, 255, 0.25),
+    0 24px 48px -20px rgba(6, 78, 59, 0.22);
+}
+
+/* --- Full frosted glass panel (dark surfaces, e.g. footer) --- */
+.glass-dark {
+  position: relative;
+  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.03) 100%);
+  -webkit-backdrop-filter: blur(18px) saturate(1.3);
+  backdrop-filter: blur(18px) saturate(1.3);
+  border: 1px solid rgba(255, 255, 255, 0.18);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.22),
+    inset 0 -1px 0 rgba(255, 255, 255, 0.06),
+    0 24px 48px -20px rgba(0, 0, 0, 0.45);
+}
+
+/* --- Edge-only glass: keeps the card's own background, adds the
+       liquid edge border, inner highlight and sheen on top --- */
+.glass-edge {
+  position: relative;
+  border: 1px solid rgba(255, 255, 255, 0.55);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.5),
+    inset 0 -1px 0 rgba(255, 255, 255, 0.12);
+}
+
+/* --- Cursor-following specular sheen --- */
+.glass-sheen {
+  overflow: hidden;
+  --sheen-x: 50%;
+  --sheen-y: 50%;
+}
+.glass-sheen::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  pointer-events: none;
+  z-index: 2;
+  background: radial-gradient(
+    420px circle at var(--sheen-x) var(--sheen-y),
+    rgba(255, 255, 255, 0.32) 0%,
+    rgba(255, 255, 255, 0.08) 38%,
+    rgba(255, 255, 255, 0) 68%
+  );
+  opacity: 0;
+  transition: opacity 0.35s ease;
+}
+.glass-sheen:hover::after {
+  opacity: 1;
+}
+
+/* --- Tilt state: fast transform response while the cursor moves --- */
+.glass-tilting {
+  transition: transform 0.12s ease-out !important;
+  will-change: transform;
+}
+
+/* --- Frosted glass navbar --- */
+.glass-nav {
+  background: linear-gradient(180deg, rgba(255, 255, 255, 0.82) 0%, rgba(240, 253, 244, 0.62) 100%);
+  -webkit-backdrop-filter: blur(20px) saturate(1.6);
+  backdrop-filter: blur(20px) saturate(1.6);
+  border-bottom: 1px solid rgba(255, 255, 255, 0.6);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.75),
+    0 12px 32px -14px rgba(6, 78, 59, 0.22);
+}
+
+/* --- Animated gradient orbs (hero / section backdrops) --- */
+.orb {
+  position: absolute;
+  border-radius: 9999px;
+  filter: blur(70px);
+  -webkit-filter: blur(70px);
+  will-change: transform;
+}
+.orb-a {
+  width: 600px;
+  height: 600px;
+  top: -190px;
+  right: -10%;
+  background: radial-gradient(circle, rgba(16, 185, 129, 0.26) 0%, rgba(16, 185, 129, 0) 65%);
+  animation: orb-drift-a 22s ease-in-out infinite alternate;
+}
+.orb-b {
+  width: 520px;
+  height: 520px;
+  bottom: -28%;
+  left: -8%;
+  background: radial-gradient(circle, rgba(167, 243, 208, 0.5) 0%, rgba(167, 243, 208, 0) 68%);
+  animation: orb-drift-b 27s ease-in-out infinite alternate;
+}
+.orb-c {
+  width: 400px;
+  height: 400px;
+  top: 32%;
+  left: 28%;
+  background: radial-gradient(circle, rgba(52, 211, 153, 0.2) 0%, rgba(52, 211, 153, 0) 70%);
+  animation: orb-drift-c 31s ease-in-out infinite alternate;
+}
+/* Dark-section orb tuning (footer) */
+.orb-tone-dark .orb-a {
+  background: radial-gradient(circle, rgba(16, 185, 129, 0.4) 0%, rgba(16, 185, 129, 0) 65%);
+}
+.orb-tone-dark .orb-b {
+  background: radial-gradient(circle, rgba(52, 211, 153, 0.22) 0%, rgba(52, 211, 153, 0) 68%);
+}
+.orb-tone-dark .orb-c {
+  background: radial-gradient(circle, rgba(167, 243, 208, 0.14) 0%, rgba(167, 243, 208, 0) 70%);
+}
+
+@keyframes orb-drift-a {
+  from { transform: translate(0, 0) scale(1); }
+  to   { transform: translate(-120px, 90px) scale(1.14); }
+}
+@keyframes orb-drift-b {
+  from { transform: translate(0, 0) scale(1.05); }
+  to   { transform: translate(110px, -80px) scale(0.94); }
+}
+@keyframes orb-drift-c {
+  from { transform: translate(0, 0) scale(0.95); }
+  to   { transform: translate(-70px, -60px) scale(1.12); }
+}
+
+/* --- Light sweep across primary CTAs on hover --- */
+.pill-cta,
+.pill-cta-inverted {
+  position: relative;
+  overflow: hidden;
+  isolation: isolate;
+}
+.pill-cta::before,
+.pill-cta-inverted::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  z-index: 1;
+  pointer-events: none;
+  background: linear-gradient(105deg, transparent 42%, rgba(255, 255, 255, 0.5) 50%, transparent 58%);
+  transform: translateX(-130%);
+  transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
+}
+.pill-cta:hover::before,
+.pill-cta-inverted:hover::before {
+  transform: translateX(130%);
+}
+
+/* --- Generic scroll reveal (used by the Reveal component) --- */
+.reveal {
+  opacity: 0;
+  transform: translateY(30px);
+  transition:
+    opacity 0.7s ease,
+    transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
+  will-change: opacity, transform;
+}
+.reveal-visible {
+  opacity: 1;
+  transform: translateY(0);
+}
+
+/* Fallback when backdrop-filter is unavailable: keep translucency readable */
+@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
+  .glass { background: rgba(255, 255, 255, 0.88); }
+  .glass-dark { background: rgba(6, 78, 59, 0.72); }
+  .glass-nav { background: rgba(255, 255, 255, 0.94); }
+}
